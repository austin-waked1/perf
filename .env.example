# ─────────────────────────  REQUIRED  ─────────────────────────

# Live WordPress + WooCommerce GraphQL endpoint (altaha.shop).
# The browser talks to WP directly (CORS is open on the WP side).
NEXT_PUBLIC_WORDPRESS_URL=https://altaha.shop/graphql

# ─────────────────────────  OPTIONAL  ─────────────────────────

# WooCommerce payment method to expose at checkout. Default: cod (cash on delivery).
# Other gateways (paypal, stripe, mollie…) need to be configured in Woo admin first.
NEXT_PUBLIC_WOOCOMMERCE_PAYMENT_METHOD=cod
